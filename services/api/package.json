{
  "name": "@portfolio/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Portfolio tracker API service (Fastify + Drizzle/Postgres)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:py": "../../.venv-pytr/bin/python -m pytest python",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo": "tsx --env-file=../../.env src/db/seed-demo.ts",
    "scrape": "tsx --env-file=../../.env src/db/scrape.ts",
    "repair:instruments": "tsx --env-file=../../.env src/db/repair-eu-instruments.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@portfolio/ai-tools": "*",
    "@portfolio/api-client": "*",
    "@portfolio/core": "*",
    "@portfolio/db": "*",
    "@portfolio/market-data": "*",
    "@portfolio/schema": "*",
    "cheerio": "^1.0.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.5",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "form-auto-content": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}

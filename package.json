{
  "name": "pocket-portfolio-tracker",
  "version": "0.2.5",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Indonesian-first personal portfolio tracker (monorepo)",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && npm run lint:scripts",
    "lint:scripts": "eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:sharded": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshots.mjs",
    "integrity": "node scripts/integrity-report.mjs",
    "demo": "node scripts/demo/instance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "^8.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10",
    "browserslist": "^4.28.7"
  }
}
